---
import BaseLayout from '../layouts/BaseLayout.astro';
import FinalCTA from '../components/home/FinalCTA.astro';
import { getCollection } from 'astro:content';

const faqs = await getCollection('faqs');
const publishedFaqs = faqs
  .filter((f) => f.data.status === 'published')
  .sort((a, b) => a.data.order - b.data.order);

const pageTitle = "Pusat Bantuan & FAQ — Tarbiyah Sunnah Learning";
const pageDescription = "Temukan jawaban atas pertanyaan umum mengenai pendaftaran, metode belajar, materi, dan sistem evaluasi di Belajar Islam Dasar (BID).";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- Hero Section -->
  <section class="faq-hero section">
    <div class="container container-reading">
      <span class="eyebrow">Pusat Bantuan</span>
      <h1 class="hero-title">Pertanyaan yang Sering Diajukan</h1>
      <p class="hero-lead">
        Berikut adalah jawaban atas pertanyaan-pertanyaan yang paling sering diajukan calon peserta mengenai program Belajar Islam Dasar (BID).
      </p>
    </div>
  </section>

  <!-- FAQ Details Section -->
  <section class="faq-body section">
    <div class="container container-reading">
      <div class="faq-list">
        {publishedFaqs.map((faq) => (
          <details class="faq-item" open>
            <summary class="faq-question">
              <span>{faq.data.question}</span>
              <span class="faq-icon" aria-hidden="true">+</span>
            </summary>
            <div class="faq-answer">
              <p>{faq.data.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <FinalCTA />
</BaseLayout>

<style>
  .faq-hero {
    background-color: var(--color-background);
    border-bottom: 1px solid var(--color-border);
    padding-block-start: var(--space-12);
    padding-block-end: var(--space-12);
  }

  @media (min-width: 768px) {
    .faq-hero {
      padding-block-start: var(--space-20);
      padding-block-end: var(--space-16);
    }
  }

  .hero-title {
    font-size: clamp(2.125rem, 4.5vw, 3.5rem);
    font-weight: 800;
    line-height: 1.15;
    color: var(--color-primary);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-6);
  }

  .hero-lead {
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    line-height: var(--line-height-relaxed);
    color: var(--color-text);
    margin-bottom: 0;
  }

  .faq-body {
    background-color: var(--color-surface);
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .faq-item {
    background-color: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-6);
    font-size: var(--font-size-md);
    font-weight: 600;
    color: var(--color-primary);
    cursor: pointer;
    list-style: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-icon {
    font-size: var(--font-size-xl);
    font-weight: 400;
    color: var(--color-muted);
  }

  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    color: var(--color-primary);
  }

  .faq-answer {
    padding-inline: var(--space-6);
    padding-bottom: var(--space-6);
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-4);
  }

  .faq-answer p {
    font-size: var(--font-size-base);
    color: var(--color-text);
    line-height: var(--line-height-body);
    margin-bottom: 0;
  }
</style>
