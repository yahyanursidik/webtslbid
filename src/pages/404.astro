---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Halaman Tidak Ditemukan (404)">
  <section class="section">
    <div class="container container-reading" style="text-align: center; padding-block: var(--space-12);">
      <span class="eyebrow">Error 404</span>
      <h1 style="margin-bottom: var(--space-4);">Halaman Tidak Ditemukan</h1>
      <p class="lead" style="margin-bottom: var(--space-8);">
        Maaf, halaman yang Anda cari tidak ditemukan atau telah dipindahkan.
      </p>
      
      <div style="display: flex; gap: var(--space-4); justify-content: center; flex-wrap: wrap;">
        <a href="/" class="btn btn-primary">
          Kembali ke Beranda
        </a>
        <a href="/program/kurikulum" class="btn btn-secondary">
          Lihat Kurikulum
        </a>
        <a href="/kontak" class="btn btn-secondary">
          Hubungi Bantuan
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
