---
import BaseLayout from '../layouts/BaseLayout.astro';
import FinalCTA from '../components/home/FinalCTA.astro';

const pageTitle = "Bantuan Bimbingan Belajar — Tarbiyah Sunnah Learning";
const pageDescription = "Panduan kendala teknis dan bantuan akses portal peserta Belajar Islam Dasar.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- Hero Section -->
  <section class="help-hero section">
    <div class="container container-reading">
      <span class="eyebrow">Panduan Peserta</span>
      <h1 class="hero-title">Pusat Bantuan Teknis</h1>
      <p class="hero-lead">
        Informasi seputar kendala login portal peserta, lupa kata sandi, dan panduan teknis akses modul pembelajaran.
      </p>
    </div>
  </section>

  <!-- Help Topics -->
  <section class="help-body section">
    <div class="container container-reading">
      <div class="help-grid">
        <div class="help-card">
          <h2>1. Kendala Akses Portal / Lupa Kata Sandi</h2>
          <p>
            Jika Anda lupa kata sandi akun portal peserta, gunakan fitur "Lupa Kata Sandi" pada halaman login portal resmi (kelas.tslbelajarislam.id) atau hubungi musyrif grup Anda.
          </p>
        </div>

        <div class="help-card">
          <h2>2. Masalah Video Modul Tidak Dapat Diputar</h2>
          <p>
            Pastikan koneksi internet Anda stabil dan perbarui peramban (browser) Anda ke versi terbaru. Jika masalah berlanjut, hapus cache browser Anda.
          </p>
        </div>

        <div class="help-card">
          <h2>3. Bimbingan Kendala Pembelajaran</h2>
          <p>
            Setiap peserta mendapatkan pendampingan musyrif/musyrifah di grup belajar masing-masing. Silakan sampaikan pertanyaan teknis maupun materi di grup tersebut.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <FinalCTA />
</BaseLayout>

<style>
  .help-hero {
    background-color: var(--color-background);
    border-bottom: 1px solid var(--color-border);
    padding-block-start: var(--space-12);
    padding-block-end: var(--space-12);
  }

  @media (min-width: 768px) {
    .help-hero {
      padding-block-start: var(--space-20);
      padding-block-end: var(--space-16);
    }
  }

  .hero-title {
    font-size: clamp(2.125rem, 4.5vw, 3.5rem);
    font-weight: 800;
    line-height: 1.15;
    color: var(--color-primary);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-6);
  }

  .hero-lead {
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    line-height: var(--line-height-relaxed);
    color: var(--color-text);
    margin-bottom: 0;
  }

  .help-body {
    background-color: var(--color-surface);
  }

  .help-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .help-card {
    padding: var(--space-6);
    background-color: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .help-card h2 {
    font-size: var(--font-size-lg);
    color: var(--color-primary);
    margin-bottom: var(--space-3);
  }

  .help-card p {
    font-size: var(--font-size-base);
    color: var(--color-text);
    line-height: var(--line-height-body);
    margin-bottom: 0;
  }
</style>
