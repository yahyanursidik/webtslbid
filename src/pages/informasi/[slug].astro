---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FinalCTA from '../../components/home/FinalCTA.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const announcements = await getCollection('announcements');
  return announcements.map((item) => ({
    params: { slug: item.id },
    props: { announcement: item },
  }));
}

const { announcement } = Astro.props;
const { Content } = await render(announcement);

const pageTitle = `${announcement.data.title} — Informasi TSL`;
const pageDescription = announcement.data.summary;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- Announcement Header -->
  <section class="info-hero section">
    <div class="container container-reading">
      <a href="/informasi" class="back-link">← Kembali ke Pusat Pengumuman</a>
      
      <div class="info-meta">
        <span class="category-tag">{announcement.data.category}</span>
        {announcement.data.urgent && <span class="badge-urgent">PENTING</span>}
        <time datetime={announcement.data.publishedAt.toISOString()}>
          {announcement.data.publishedAt.toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
      </div>

      <h1 class="info-title">{announcement.data.title}</h1>
    </div>
  </section>

  <!-- Content Body -->
  <section class="info-content section">
    <div class="container container-reading">
      <div class="prose-lead">
        <p>{announcement.data.summary}</p>
      </div>

      <div class="markdown-body">
        <Content />
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <FinalCTA />
</BaseLayout>

<style>
  .info-hero {
    background-color: var(--color-background);
    border-bottom: 1px solid var(--color-border);
    padding-block-start: var(--space-10);
    padding-block-end: var(--space-12);
  }

  .back-link {
    font-size: var(--font-size-xs);
    font-weight: 600;
    color: var(--color-muted);
    text-decoration: none;
    display: inline-block;
    margin-bottom: var(--space-6);
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--color-primary);
  }

  .info-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--font-size-xs);
    color: var(--color-muted);
    margin-bottom: var(--space-3);
  }

  .category-tag {
    font-weight: 700;
    color: var(--color-accent);
    text-transform: uppercase;
  }

  .badge-urgent {
    background-color: var(--color-accent);
    color: #FFFFFF;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 2px;
  }

  .info-title {
    font-size: clamp(2.125rem, 4vw, 3rem);
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1.2;
    margin-bottom: 0;
  }

  .info-content {
    background-color: var(--color-surface);
  }

  .prose-lead {
    font-size: var(--font-size-lg);
    font-weight: 600;
    color: var(--color-text);
    line-height: var(--line-height-relaxed);
    margin-bottom: var(--space-8);
    padding-left: var(--space-6);
    border-left: 3px solid var(--color-accent);
  }
</style>
