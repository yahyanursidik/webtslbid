---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FinalCTA from '../../components/home/FinalCTA.astro';
import { getCollection } from 'astro:content';

const announcements = await getCollection('announcements');
const publishedAnnouncements = announcements
  .filter((a) => a.data.status === 'published')
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const pageTitle = "Pengumuman & Informasi Resmi — Tarbiyah Sunnah Learning";
const pageDescription = "Pusat pengumuman resmi dan informasi terbaru seputar kegiatan serta pendaftaran Belajar Islam Dasar (BID).";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- Hero Section -->
  <section class="info-hero section">
    <div class="container container-reading">
      <span class="eyebrow">Pusat Informasi</span>
      <h1 class="hero-title">Pengumuman Resmi</h1>
      <p class="hero-lead">
        Informasi terkini mengenai jadwal pendaftaran angkatan baru, kalender akademis, dan berita penting dari pengelola TSL.
      </p>
    </div>
  </section>

  <!-- Announcements List -->
  <section class="info-directory section">
    <div class="container container-reading">
      <div class="info-grid">
        {publishedAnnouncements.map((item) => (
          <div class={`info-card ${item.data.urgent ? 'urgent-card' : ''}`}>
            <div class="card-meta">
              <span class="category-tag">{item.data.category}</span>
              {item.data.urgent && <span class="badge-urgent">PENTING</span>}
              <time datetime={item.data.publishedAt.toISOString()}>
                {item.data.publishedAt.toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
            </div>

            <h2 class="card-title">
              <a href={`/informasi/${item.id}`} class="info-link">
                {item.data.title}
              </a>
            </h2>

            <p class="card-summary">{item.data.summary}</p>

            <a href={`/informasi/${item.id}`} class="link-editorial">
              Baca Pengumuman Selengkapnya →
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <FinalCTA />
</BaseLayout>

<style>
  .info-hero {
    background-color: var(--color-background);
    border-bottom: 1px solid var(--color-border);
    padding-block-start: var(--space-12);
    padding-block-end: var(--space-12);
  }

  @media (min-width: 768px) {
    .info-hero {
      padding-block-start: var(--space-20);
      padding-block-end: var(--space-16);
    }
  }

  .hero-title {
    font-size: clamp(2.125rem, 4.5vw, 3.5rem);
    font-weight: 800;
    line-height: 1.15;
    color: var(--color-primary);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-6);
  }

  .hero-lead {
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    line-height: var(--line-height-relaxed);
    color: var(--color-text);
    margin-bottom: 0;
  }

  .info-directory {
    background-color: var(--color-surface);
  }

  .info-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .info-card {
    padding: var(--space-6);
    background-color: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .urgent-card {
    border-left: 4px solid var(--color-accent);
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--font-size-xs);
    color: var(--color-muted);
    margin-bottom: var(--space-3);
  }

  .category-tag {
    font-weight: 700;
    color: var(--color-accent);
    text-transform: uppercase;
  }

  .badge-urgent {
    background-color: var(--color-accent);
    color: #FFFFFF;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 2px;
  }

  .card-title {
    font-size: var(--font-size-lg);
    margin-bottom: var(--space-2);
  }

  .info-link {
    color: var(--color-primary);
    text-decoration: none;
  }

  .info-link:hover {
    text-decoration: underline;
  }

  .card-summary {
    font-size: var(--font-size-base);
    color: var(--color-text);
    line-height: var(--line-height-body);
    margin-bottom: var(--space-4);
  }
</style>
