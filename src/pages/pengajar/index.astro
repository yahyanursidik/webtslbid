---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FinalCTA from '../../components/home/FinalCTA.astro';
import { getCollection } from 'astro:content';

const teachers = await getCollection('teachers');
const publishedTeachers = teachers.filter((t) => t.data.status === 'published');

const pageTitle = "Tim Pengajar Tarbiyah Sunnah Learning";
const pageDescription = "Mengenal para asatidzah dan tim pengajar yang membimbing materi pembelajaran di Belajar Islam Dasar (BID).";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- Hero Section -->
  <section class="teachers-hero section">
    <div class="container container-reading">
      <span class="eyebrow">Asatidzah & Tim Pengajar</span>
      <h1 class="hero-title">Tim Pengajar BID</h1>
      <p class="hero-lead">
        Materi pembelajaran di Belajar Islam Dasar disampaikan oleh para asatidzah yang berkomitmen pada prinsip pemahaman agama berbasis dalil Al-Qur'an dan As-Sunnah yang shahih.
      </p>
    </div>
  </section>

  <!-- Teachers List -->
  <section class="teachers-directory section">
    <div class="container">
      <div class="teachers-grid">
        {publishedTeachers.map((teacher) => {
          const initials = teacher.data.name
            .split(' ')
            .map((n) => n[0])
            .slice(0, 2)
            .join('')
            .toUpperCase();

          return (
            <div class="teacher-card">
              <div class="teacher-avatar">
                {teacher.data.photo ? (
                  <img
                    src={teacher.data.photo}
                    alt={`Foto ${teacher.data.name}`}
                    width="100"
                    height="100"
                    loading="lazy"
                  />
                ) : (
                  <div class="monogram-placeholder" aria-label={`Inisial ${teacher.data.name}`}>
                    <span>{initials}</span>
                  </div>
                )}
              </div>

              <div class="teacher-details">
                <h2 class="teacher-name">{teacher.data.name}</h2>
                <p class="teacher-bio">{teacher.data.shortBio}</p>
                <div class="card-footer">
                  <a href={`/pengajar/${teacher.id}`} class="btn btn-secondary btn-sm">
                    Lihat Profil Pengajar →
                  </a>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <FinalCTA />
</BaseLayout>

<style>
  .teachers-hero {
    background-color: var(--color-background);
    border-bottom: 1px solid var(--color-border);
    padding-block-start: var(--space-12);
    padding-block-end: var(--space-12);
  }

  @media (min-width: 768px) {
    .teachers-hero {
      padding-block-start: var(--space-20);
      padding-block-end: var(--space-16);
    }
  }

  .hero-title {
    font-size: clamp(2.125rem, 4.5vw, 3.5rem);
    font-weight: 800;
    line-height: 1.15;
    color: var(--color-primary);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-6);
  }

  .hero-lead {
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    line-height: var(--line-height-relaxed);
    color: var(--color-text);
    margin-bottom: 0;
  }

  .teachers-directory {
    background-color: var(--color-surface);
  }

  .teachers-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    max-width: var(--max-width-reading);
    margin-inline: auto;
  }

  .teacher-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding: var(--space-8);
    background-color: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  @media (min-width: 640px) {
    .teacher-card {
      flex-direction: row;
      align-items: start;
    }
  }

  .teacher-avatar {
    flex-shrink: 0;
  }

  .teacher-avatar img {
    width: 90px;
    height: 90px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--color-primary-soft);
  }

  .monogram-placeholder {
    width: 90px;
    height: 90px;
    border-radius: 50%;
    background-color: var(--color-primary);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-serif);
    font-size: var(--font-size-xl);
    font-weight: 700;
    border: 2px solid var(--color-accent);
  }

  .teacher-details {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .teacher-name {
    font-size: var(--font-size-xl);
    color: var(--color-primary);
    margin-bottom: 0;
  }

  .teacher-bio {
    font-size: var(--font-size-base);
    color: var(--color-text);
    line-height: var(--line-height-body);
    margin-bottom: 0;
  }

  .card-footer {
    margin-top: var(--space-2);
  }

  .btn-sm {
    min-height: 40px;
    padding-inline: var(--space-4);
    font-size: var(--font-size-xs);
  }
</style>
