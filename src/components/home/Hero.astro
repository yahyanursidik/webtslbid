---
---

<section class="hero-section">
  <div class="container">
    <div class="hero-content">
      <!-- Eyebrow Tagline -->
      <span class="eyebrow hero-eyebrow">Tarbiyah Sunnah Learning — Program Belajar Islam Dasar (BID)</span>

      <!-- Main Headline -->
      <h1 class="hero-title">
        Belajar Islam dari Dasarnya, Bertahap dan Terarah.
      </h1>

      <!-- Body Copy -->
      <p class="hero-body">
        Program Belajar Islam Dasar membantu peserta membangun fondasi pembelajaran Islam melalui materi yang disusun secara sistematis dan dapat diikuti secara bertahap.
      </p>

      <!-- Action Buttons -->
      <div class="hero-actions">
        <a href="/pendaftaran" class="btn btn-primary btn-hero">
          Daftar BID
        </a>
        <a href="/program/kurikulum" class="btn btn-secondary btn-hero">
          Lihat Kurikulum
        </a>
      </div>

      <!-- Institutional Highlights -->
      <div class="hero-highlights">
        <div class="highlight-item">
          <span class="highlight-bullet" aria-hidden="true">•</span>
          <span>Metode Belajar Terstruktur</span>
        </div>
        <div class="highlight-item">
          <span class="highlight-bullet" aria-hidden="true">•</span>
          <span>Kurikulum Berjenjang</span>
        </div>
        <div class="highlight-item">
          <span class="highlight-bullet" aria-hidden="true">•</span>
          <span>Berbasis Dalil Al-Qur'an & As-Sunnah</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding-block-start: var(--space-12);
    padding-block-end: var(--space-16);
    background-color: var(--color-background);
    border-bottom: 1px solid var(--color-border);
  }

  @media (min-width: 768px) {
    .hero-section {
      padding-block-start: var(--space-20);
      padding-block-end: var(--space-24);
    }
  }

  .hero-content {
    max-width: var(--max-width-reading);
    margin-inline: auto;
    text-align: left;
  }

  .hero-eyebrow {
    margin-bottom: var(--space-3);
  }

  .hero-title {
    font-size: clamp(2.125rem, 4.5vw, 3.5rem);
    font-weight: 800;
    line-height: 1.15;
    color: var(--color-primary);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-6);
  }

  .hero-body {
    font-size: clamp(1.0625rem, 2vw, 1.25rem);
    line-height: var(--line-height-relaxed);
    color: var(--color-text);
    margin-bottom: var(--space-8);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-bottom: var(--space-10);
  }

  .btn-hero {
    min-height: 48px;
    padding-inline: var(--space-8);
    font-size: var(--font-size-base);
  }

  .hero-highlights {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .highlight-item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-size-xs);
    font-weight: 600;
    color: var(--color-muted);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .highlight-bullet {
    color: var(--color-primary);
    font-size: var(--font-size-base);
  }
</style>
