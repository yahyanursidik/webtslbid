---
const steps = [
  {
    step: "01",
    label: "Mulai",
    title: "Niat & Kesadaran",
    desc: "Membangun motivasi dan kesadaran pentingnya menuntut ilmu agama secara terarah."
  },
  {
    step: "02",
    label: "Fondasi",
    title: "Tauhid & Aqidah",
    desc: "Memperkokoh keyakinan dasar dan prinsip keimanan Ahlus Sunnah wal Jama'ah."
  },
  {
    step: "03",
    label: "Pemahaman",
    title: "Fikih Ibadah",
    desc: "Memahami tata cara thaharah, shalat, dan ibadah harian berbasis dalil shahih."
  },
  {
    step: "04",
    label: "Praktik",
    title: "Pengamalan Sunnah",
    desc: "Menerapkan ilmu ibadah dan muamalah harian secara konsisten dalam kehidupan."
  },
  {
    step: "05",
    label: "Bertumbuh",
    title: "Adab & Istiqamah",
    desc: "Menjaga adab islami dan melanjutkan perjalanan belajar ke tingkat berikutnya."
  }
];
---

<section class="framework-section section">
  <div class="container">
    <div class="framework-header">
      <span class="eyebrow">Alur Pembelajaran</span>
      <h2 class="framework-title">Kerangka Belajar Bertahap (Learning Framework)</h2>
      <p class="framework-subtitle">
        Progres belajar disusun secara terurut agar peserta berkembang secara bertahap tanpa merasa terbebani.
      </p>
    </div>

    <!-- HTML/CSS Pure Diagram Flow -->
    <div class="framework-flow" role="list">
      {steps.map((item, idx) => (
        <div class="flow-step" role="listitem">
          <div class="step-badge-wrap">
            <div class="step-badge">{item.step}</div>
            {idx < steps.length - 1 && <div class="flow-connector" aria-hidden="true"></div>}
          </div>
          <div class="step-content">
            <span class="step-label">{item.label}</span>
            <h3 class="step-title">{item.title}</h3>
            <p class="step-desc">{item.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .framework-section {
    background-color: var(--color-background);
    border-bottom: 1px solid var(--color-border);
  }

  .framework-header {
    max-width: var(--max-width-reading);
    margin-bottom: var(--space-12);
  }

  .framework-title {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    color: var(--color-primary);
    margin-bottom: var(--space-3);
  }

  .framework-subtitle {
    font-size: var(--font-size-md);
    color: var(--color-muted);
    line-height: var(--line-height-relaxed);
    margin-bottom: 0;
  }

  /* Responsive Pure HTML/CSS Flow */
  .framework-flow {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 992px) {
    .framework-flow {
      grid-template-columns: repeat(5, 1fr);
      gap: var(--space-4);
    }
  }

  .flow-step {
    display: flex;
    flex-direction: column;
    position: relative;
    background-color: var(--color-surface);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .step-badge-wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
  }

  .step-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background-color: var(--color-primary);
    color: #FFFFFF;
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    font-weight: 700;
    border-radius: 50%;
  }

  .flow-connector {
    display: none;
  }

  @media (min-width: 992px) {
    .flow-connector {
      display: block;
      flex: 1;
      height: 2px;
      background-color: var(--color-border);
      margin-left: var(--space-3);
    }
  }

  .step-label {
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-accent);
    display: block;
    margin-bottom: var(--space-1);
  }

  .step-title {
    font-size: var(--font-size-md);
    color: var(--color-primary);
    margin-bottom: var(--space-2);
  }

  .step-desc {
    font-size: var(--font-size-sm);
    color: var(--color-muted);
    line-height: var(--line-height-body);
    margin-bottom: 0;
  }
</style>
