<section class="final-cta-section section">
  <div class="container container-reading">
    <div class="final-cta-card">
      <span class="eyebrow cta-eyebrow">Tarbiyah Sunnah Learning</span>
      <h2 class="cta-headline">
        Mulai dari dasar. Bertumbuh bersama ilmu.
      </h2>
      <p class="cta-subtitle">
        Bangun fondasi pembelajaran Islam Anda secara terstruktur dan bertahap melalui program Belajar Islam Dasar (BID).
      </p>
      
      <div class="cta-actions">
        <a href="/pendaftaran" class="btn btn-primary btn-cta">
          Daftar BID
        </a>
        <a href="/program/kurikulum" class="btn btn-secondary btn-cta">
          Lihat Kurikulum
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .final-cta-section {
    background-color: var(--color-surface);
    padding-block: var(--space-16);
  }

  @media (min-width: 768px) {
    .final-cta-section {
      padding-block: var(--space-24);
    }
  }

  .final-cta-card {
    padding: var(--space-8);
    background-color: var(--color-primary-soft);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    text-align: left;
    border-left: 6px solid var(--color-primary);
  }

  @media (min-width: 768px) {
    .final-cta-card {
      padding: var(--space-12);
    }
  }

  .cta-eyebrow {
    margin-bottom: var(--space-3);
  }

  .cta-headline {
    font-size: clamp(1.875rem, 3.5vw, 2.75rem);
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-4);
  }

  .cta-subtitle {
    font-size: clamp(1rem, 1.8vw, 1.25rem);
    color: var(--color-text);
    line-height: var(--line-height-relaxed);
    margin-bottom: var(--space-8);
    max-width: 640px;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .btn-cta {
    min-height: 48px;
    padding-inline: var(--space-8);
    font-size: var(--font-size-base);
  }
</style>
