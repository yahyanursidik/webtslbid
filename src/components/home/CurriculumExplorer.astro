---
import { getCollection } from 'astro:content';

const subjects = await getCollection('subjects');
const publishedSubjects = subjects
  .filter((s) => s.data.status === 'published')
  .sort((a, b) => a.data.order - b.data.order);

// Group subjects by category
const groupedSubjects = publishedSubjects.reduce<Record<string, typeof publishedSubjects>>((acc, subject) => {
  const cat = subject.data.category || 'Materi Utama';
  if (!acc[cat]) acc[cat] = [];
  acc[cat].push(subject);
  return acc;
}, {});
---

<section class="curriculum-section section">
  <div class="container">
    <div class="curriculum-header">
      <span class="eyebrow">Kurikulum & Silabus</span>
      <h2 class="curriculum-title">Eksplorasi Mata Pelajaran BID</h2>
      <p class="curriculum-subtitle">
        Materi pembelajaran yang dirancang secara berurutan untuk membentuk pemahaman Islam yang utuh.
      </p>
    </div>

    <!-- Editorial Hierarchy List (No Card Slop) -->
    <div class="curriculum-groups">
      {Object.entries(groupedSubjects).map(([category, subjectList]) => (
        <div class="curriculum-group">
          <div class="group-header">
            <h3 class="group-title">{category}</h3>
            <span class="group-count">{subjectList.length} Mata Pelajaran</span>
          </div>

          <div class="subject-list">
            {subjectList.map((subject) => (
              <div class="subject-item">
                <div class="subject-main">
                  <div class="subject-badge">Modul {subject.data.order}</div>
                  <h4 class="subject-name">
                    <a href={`/program/kurikulum#${subject.id}`} class="subject-link">
                      {subject.data.title}
                    </a>
                  </h4>
                  <p class="subject-summary">{subject.data.summary}</p>
                </div>

                <div class="subject-objectives">
                  <span class="objectives-heading">Target Capaian:</span>
                  <ul class="objectives-list">
                    {subject.data.learningObjectives.slice(0, 2).map((obj) => (
                      <li>✓ {obj}</li>
                    ))}
                  </ul>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div class="curriculum-footer">
      <a href="/program/kurikulum" class="btn btn-secondary">
        Lihat Silabus Selengkapnya →
      </a>
    </div>
  </div>
</section>

<style>
  .curriculum-section {
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .curriculum-header {
    max-width: var(--max-width-reading);
    margin-bottom: var(--space-12);
  }

  .curriculum-title {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    color: var(--color-primary);
    margin-bottom: var(--space-3);
  }

  .curriculum-subtitle {
    font-size: var(--font-size-md);
    color: var(--color-muted);
    line-height: var(--line-height-relaxed);
    margin-bottom: 0;
  }

  .curriculum-groups {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  .curriculum-group {
    border-top: 2px solid var(--color-primary);
    padding-top: var(--space-6);
  }

  .group-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--space-6);
  }

  .group-title {
    font-size: var(--font-size-xl);
    color: var(--color-primary);
  }

  .group-count {
    font-size: var(--font-size-xs);
    font-weight: 600;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .subject-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .subject-item {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    padding: var(--space-6);
    background-color: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  @media (min-width: 768px) {
    .subject-item {
      grid-template-columns: 1.2fr 1fr;
      gap: var(--space-8);
      align-items: start;
    }
  }

  .subject-badge {
    display: inline-block;
    font-size: var(--font-size-xs);
    font-weight: 700;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-2);
  }

  .subject-name {
    font-size: var(--font-size-lg);
    margin-bottom: var(--space-2);
  }

  .subject-link {
    color: var(--color-primary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .subject-link:hover {
    color: var(--color-primary-hover);
    text-decoration: underline;
  }

  .subject-summary {
    font-size: var(--font-size-sm);
    color: var(--color-text);
    line-height: var(--line-height-body);
    margin-bottom: 0;
  }

  .subject-objectives {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-3);
  }

  @media (min-width: 768px) {
    .subject-objectives {
      border-top: none;
      border-left: 1px solid var(--color-border);
      padding-top: 0;
      padding-left: var(--space-6);
    }
  }

  .objectives-heading {
    display: block;
    font-size: var(--font-size-xs);
    font-weight: 700;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: var(--space-2);
  }

  .objectives-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .objectives-list li {
    font-size: var(--font-size-xs);
    color: var(--color-text);
    line-height: 1.5;
  }

  .curriculum-footer {
    margin-top: var(--space-10);
    text-align: left;
  }
</style>
